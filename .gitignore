# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd

# ── Environment files ─────────────────────────────────────────────────────────
.env
venv/
.venv/

# ── Data files (raw/large files – back up separately) ─────────────────────────
*.csv
*.db
*.sqlite
*.xlsx
*.json

# ── Large model/feature files (>100MB – GitHub limit) ──────────────────────────
data/serie_a_pv_features.parquet

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Generated outputs ─────────────────────────────────────────────────────────
graphify-out/
outputs/

# ── OS / Editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.egg-info/

# Ignore everything under data/ by default (raw Opta CSVs, cache, external
# CSVs, etc. — most of it also matches *.csv/*.json above), but explicitly
# re-include the precomputed parquet directories the app reads from so a
# future precompute run doesn't get silently excluded from git.
# NOTE: git can't re-include a file whose parent dir is excluded, hence
# `data/*` (not `data/`) plus a directory-level exception for each folder.
data/*
!data/ready/
!data/ready/*.parquet
!data/processed/
!data/processed/*.parquet
